{
  "name": "openclaw-plugin-memory-engine",
  "version": "4.2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && openclaw plugins build",
    "plugin:build": "npm run build && openclaw plugins build --entry ./dist/index.js",
    "plugin:validate": "npm run build && openclaw plugins validate --entry ./dist/index.js",
    "test": "vitest run --config ./vitest.config.ts"
  },
  "files": [
    "dist",
    "!dist/index.test.js",
    "!dist/index.test.d.ts",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE",
    "assets"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.5.17"
  },
  "dependencies": {
    "typebox": "^1.1.38"
  },
  "devDependencies": {
    "openclaw": "latest",
    "typescript": "^7.0.2",
    "vitest": "^3.3.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.5.17"
    },
    "build": {
      "openclawVersion": "2026.9.7"
    },
    "controlUi": "./src/control-ui.ts"
  },
  "description": "Native Memory Engine for OpenClaw: 45 memory tools (recall, working set, curator, semantic, backup, learning) + session ingest/digest + Control UI",
  "license": "MIT",
  "keywords": [
    "openclaw",
    "plugin",
    "memory",
    "knowledge-graph",
    "curator"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SimoneB79/memory-engine-mcp.git"
  }
}
