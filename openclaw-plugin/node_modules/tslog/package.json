{
  "name": "tslog",
  "version": "5.2.0",
  "description": "Extensible TypeScript Logger for Node.js and Browser.",
  "keywords": [
    "logger",
    "typescript",
    "log level",
    "json",
    "stacktrace",
    "Error.stack",
    "call location",
    "debug",
    "pretty",
    "log",
    "log4j",
    "log4js",
    "log4ts",
    "print",
    "logging",
    "stack",
    "trace",
    "pretty print",
    "prettify",
    "format",
    "human",
    "callsites",
    "callsite",
    "show error",
    "handling exceptions",
    "pretty log",
    "pretty json",
    "pretty-error",
    "sourcemap"
  ],
  "homepage": "https://tslog.js.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fullstack-build/tslog.git"
  },
  "bugs": {
    "url": "https://github.com/fullstack-build/tslog/issues"
  },
  "author": "Eugene <opensource@terehov.de> (https://fullstack.build)",
  "license": "MIT",
  "funding": "https://github.com/fullstack-build/tslog?sponsor=1",
  "sideEffects": false,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "module": "./esm/index.universal.js",
  "types": "./types/index.d.ts",
  "browser": {
    "tslog": "./browser/index.js",
    "util": false
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "browser": "./esm/index.browser.js",
      "worker": "./esm/index.browser.js",
      "deno": "./esm/index.universal.js",
      "bun": "./esm/index.universal.js",
      "node": "./esm/index.node.js",
      "react-native": "./esm/index.universal.js",
      "default": "./esm/index.universal.js"
    },
    "./transports/file": {
      "types": "./types/subpaths/transports/file.d.ts",
      "node": "./esm/subpaths/transports/file.js",
      "default": "./esm/subpaths/transports/file.js"
    },
    "./transports/http": {
      "types": "./types/subpaths/transports/http.d.ts",
      "default": "./esm/subpaths/transports/http.js"
    },
    "./transports/ringbuffer": {
      "types": "./types/subpaths/transports/ringBuffer.d.ts",
      "default": "./esm/subpaths/transports/ringBuffer.js"
    },
    "./transports/worker": {
      "types": "./types/subpaths/transports/worker.d.ts",
      "node": "./esm/subpaths/transports/worker.js",
      "default": "./esm/subpaths/transports/worker.js"
    },
    "./presets/pino": {
      "types": "./types/subpaths/presets/pino.d.ts",
      "default": "./esm/subpaths/presets/pino.js"
    },
    "./otel": {
      "types": "./types/subpaths/presets/otel.d.ts",
      "default": "./esm/subpaths/presets/otel.js"
    },
    "./presets/genai": {
      "types": "./types/subpaths/presets/genai.d.ts",
      "default": "./esm/subpaths/presets/genai.js"
    },
    "./serializers": {
      "types": "./types/subpaths/serializers/std.d.ts",
      "default": "./esm/subpaths/serializers/std.js"
    },
    "./lite": {
      "types": "./types/subpaths/lite.d.ts",
      "default": "./esm/subpaths/lite.js"
    },
    "./slim": {
      "types": "./types/subpaths/slim.d.ts",
      "default": "./esm/subpaths/slim.js"
    },
    "./console": {
      "types": "./types/subpaths/wrapConsole.d.ts",
      "default": "./esm/subpaths/wrapConsole.js"
    },
    "./testing": {
      "types": "./types/subpaths/testing.d.ts",
      "default": "./esm/subpaths/testing.js"
    },
    "./pretty/box": {
      "types": "./types/subpaths/pretty/box.d.ts",
      "default": "./esm/subpaths/pretty/box.js"
    },
    "./throttle": {
      "types": "./types/subpaths/throttle.d.ts",
      "default": "./esm/subpaths/throttle.js"
    },
    "./cli": {
      "types": "./types/subpaths/cli.d.ts",
      "node": "./esm/subpaths/cli.js",
      "default": "./esm/subpaths/cli.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "tslog": "./esm/subpaths/cli.js"
  },
  "react-native": "./esm/index.universal.js",
  "publishConfig": {
    "access": "public"
  }
}
