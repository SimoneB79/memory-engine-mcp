{
  "id": "memory-engine",
  "name": "Memory Engine",
  "description": "Native Memory Engine: 50 memory tools (binding rules!), session ingest/digest, curator and Control UI.",
  "version": "4.6.8",
  "configSchema": {
    "type": "object",
    "properties": {
      "ingest": {
        "type": "object",
        "description": "Session ingest (chat memory capture) controls.",
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false,
            "description": "Capture OpenClaw chat contents into the memory database. Default false (privacy-first); set true to enable session ingest."
          },
          "retention_days": {
            "type": "number",
            "default": 7,
            "description": "Days before session_msg/session_digest atoms expire automatically."
          }
        },
        "additionalProperties": false
      },
      "semantic": {
        "type": "object",
        "description": "Semantic search settings (embedding-based, smarter than keyword FTS).",
        "properties": {
          "default_enabled": {
            "type": "boolean",
            "default": true,
            "description": "Use semantic search by default on memory_recall and memory_working_set. True = smarter results (recommended); False = keyword-only (faster, less intelligent). Can be overridden per-call with semantic=true/false."
          }
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  },
  "activation": {
    "onStartup": true
  },
  "controlUi": {
    "entry": "dist/control-ui/82ce4c8293253f6e0303496deeec9fab6b1b501b0f5dfb59dcb4ffd7cf9860c1/index.js"
  },
  "doctorContract": {
    "stateMigrations": []
  },
  "contracts": {
    "tools": [
      "memory_version",
      "memory_recall",
      "memory_remember",
      "memory_working_set",
      "memory_get_atom",
      "memory_list_atoms",
      "memory_link",
      "memory_search_graph",
      "memory_contradict",
      "memory_impact",
      "memory_preference_search",
      "memory_error_check",
      "memory_error_log",
      "memory_stats",
      "memory_session_summary",
      "memory_generate_session_digest",
      "memory_admin",
      "memory_curator_run",
      "memory_cognitive_status",
      "memory_summary",
      "memory_delete_atom",
      "memory_unlink",
      "memory_error_list",
      "memory_list_contradictions",
      "memory_decay_run",
      "memory_update_domain",
      "memory_classify_memory_tier",
      "memory_cleanup_sessions",
      "memory_find_similar",
      "memory_merge_atoms",
      "memory_cleanup_duplicates",
      "memory_semantic_search",
      "memory_reindex_embeddings",
      "memory_suggest_bonds",
      "memory_suggest_bonds_all",
      "memory_backup_database",
      "memory_restore_database",
      "memory_list_backups",
      "memory_export_all",
      "memory_export_atom",
      "memory_import_data",
      "memory_import_markdown",
      "memory_learning_run",
      "memory_ask_pending",
      "memory_answer_human",
      "memory_recall_session",
      "memory_rules_get_binding",
      "memory_rules_add",
      "memory_rules_remove",
      "memory_rules_list_all"
    ]
  }
}
